        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Model recall / AUC on replay (simulated)",
      "description": "SIMULATED: comes from the replay script / drift check, not from real customers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(model_recall)",
          "legendFormat": "recall",
          "refId": "A",
          "instant": false,
          "range": true
