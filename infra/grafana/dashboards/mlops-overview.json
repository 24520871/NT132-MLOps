        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Quality gate: latest results",
      "description": "Read from the MLflow database: tags set by `mlops.registry.promote` on each candidate.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mlflow-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlflow-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT mv.version AS \"version\", g.value AS \"gate\", COALESCE(r.value, '') AS \"reasons\", to_timestamp(mv.creation_time / 1000) AS \"created\" FROM model_versions mv JOIN model_version_tags g ON g.name = mv.name AND g.version = mv.version AND g.key = 'gate' LEFT JOIN model_version_tags r ON r.name = mv.name AND r.version = mv.version AND r.key = 'gate_reasons' WHERE mv.name = 'churn' ORDER BY mv.version DESC LIMIT 5",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gate"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "accepted": {
                        "color": "green",
                        "text": "accepted"
                      },
                      "rejected": {
                        "color": "red",
                        "text": "rejected"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}