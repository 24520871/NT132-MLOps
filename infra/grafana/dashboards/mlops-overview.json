          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(data_drift_detected)",
          "legendFormat": "drift detected (0/1)",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 1
