# Python / environments
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# MLflow local stores and model artifacts
mlflow.db
mlflow.db-*
mlruns/
mlartifacts/

# Data: anchored to the repo root (an unanchored `data/` also hid src/mlops/data/).
# Only the small PUBLIC Telco CSV (+ its .dvc pointer and README) is committed so teammates can run immediately.
# Any other dataset stays out of git (use DVC + S3 remote).
/data/*
!/data/raw/
/data/raw/*
!/data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
!/data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv.dvc
!/data/raw/README.txt

