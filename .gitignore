kaggle.json

# Terraform state and variable files (can contain secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log

# Airflow / local service state
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py
.docker/

# Editor / OS / tool-local settings
.claude/settings.local.json
.idea/
.vscode/
.DS_Store
Thumbs.db
