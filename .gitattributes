# Normalize line endings so files written on Windows work inside Linux containers/CI
* text=auto

# Must stay LF (CRLF breaks them in Linux containers)
*.sh text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary
