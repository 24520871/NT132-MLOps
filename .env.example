# Copy to `.env` for local overrides. `.env` is git-ignored: NEVER put real secrets in this example file.
# The Python code reads these from the process environment (it does not load .env itself);
# docker compose (Stage E) will load `.env` automatically.

# --- Used by the current MVP (src/mlops/config.py); all optional, defaults shown ---
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_ARTIFACT_ROOT=./mlruns
# DATA_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
# PROJECT_ROOT=
# MLFLOW_DISABLE_AGENT_HINT=1

# --- Placeholders for later stages (fill locally, never commit real values) ---
# Stage E (docker compose): copy this file to .env and set your OWN password
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow
# Stage F (AWS): prefer an instance IAM role / SSO profile; do NOT store access keys here
# Needed only by docker-compose.prod.yml (uncomment and fill on the EC2 instance / the laptop that pushes images):
# AWS_REGION=ap-southeast-2
# S3_BUCKET=<your-bucket-name>
# ECR_REGISTRY=<account-id>.dkr.ecr.ap-southeast-2.amazonaws.com
# AWS_PROFILE=

# Stage G (Airflow overlay: docker-compose.airflow.yml). Set your OWN values; generate the secret key with
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me
# Optional: token required by POST /admin/reload (sent as X-Admin-Token by the DAG's reload task). Empty = no check.
# ADMIN_TOKEN=
# Optional: how often the API re-checks the `production` alias, in seconds (default 30)
# MODEL_POLL_SECONDS=30
# Optional on Linux hosts: uid that owns the shared artifact volume (default 1000)
# AIRFLOW_UID=1000
