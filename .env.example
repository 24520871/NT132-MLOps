# Copy to `.env` for local overrides. `.env` is git-ignored: NEVER put real secrets in this example file.
# The Python code reads these from the process environment (it does not load .env itself);
# docker compose (Stage E) will load `.env` automatically.

# --- Used by the current MVP (src/mlops/config.py); all optional, defaults shown ---
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_ARTIFACT_ROOT=./mlruns
# DATA_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
# PROJECT_ROOT=
# MLFLOW_DISABLE_AGENT_HINT=1

# --- Placeholders for later stages (fill locally, never commit real values) ---
# Stage E (docker compose): copy this file to .env and set your OWN password
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow
# Stage F (AWS): prefer an instance IAM role / SSO profile; do NOT store access keys here
# AWS_REGION=
# AWS_PROFILE=
# S3_BUCKET=
